{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/check-file.js\"",
            "timeout": 60,
            "statusMessage": "ตรวจ lint/type ของไฟล์ที่เพิ่งแก้"
          }
        ]
      }
    ]
  }
}
